# XFI AI Gateway providers
GROQ_API_KEY=
GEMINI_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
SAMBANOVA_API_KEY=
CEREBRAS_API_KEY=
HF_TOKEN=
COHERE_API_KEY=

# Optional OpenClaw control plane
ROUTERAI_API_KEY=
TELEGRAM_BOT_TOKEN=
OPENCLAW_HEARTBEAT=15m

# XFI AI provider order
XFI_AI_PROVIDERS=groq,gemini,cloudflare,openrouter,mistral,sambanova,cerebras,huggingface,cohere

GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-2.5-flash
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct
OPENROUTER_MODEL=openrouter/free
MISTRAL_MODEL=mistral-small-latest
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
CEREBRAS_MODEL=gpt-oss-120b
HF_MODEL=openai/gpt-oss-120b:fastest
COHERE_MODEL=command-a-03-2025

# XFI AI admin and VPS inventory
XFI_AI_ADMIN_KEY=
XFI_AI_DB=/var/lib/xfi-ai/keys.db
XFI_AI_KEY_PEPPER=
# Required only if future encrypted secret storage is enabled; SSH passwords are not stored by the current VPS manager.
XFI_AI_VPS_SECRET=
