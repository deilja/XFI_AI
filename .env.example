# XFI AI provider keys. Leave unused providers empty.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
SAMBANOVA_API_KEY=
CEREBRAS_API_KEY=
HF_TOKEN=

# Failover order
XFI_AI_PROVIDERS=groq,gemini,openrouter,mistral,sambanova,cerebras,huggingface

GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_MODEL=openrouter/free
MISTRAL_MODEL=mistral-small-latest
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
CEREBRAS_MODEL=gpt-oss-120b
HF_MODEL=openai/gpt-oss-120b:fastest

XFI_AI_ADMIN_KEY=
XFI_AI_DB=/var/lib/xfi-ai/keys.db
XFI_AI_KEY_PEPPER=
XFI_AI_REFERER=
