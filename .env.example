# AI provider keys. Leave a provider empty to disable it.
GROQ_API_KEY=replace_with_groq_key
GEMINI_API_KEY=replace_with_gemini_key
OPENROUTER_API_KEY=replace_with_openrouter_key

# Provider order = failover order.
XFI_AI_PROVIDERS=groq,gemini,openrouter
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_MODEL=openrouter/free
XFI_AI_REFERER=https://ai.example.com

XFI_AI_ADMIN_KEY=replace_with_long_random_value
XFI_AI_DB=/var/lib/xfi-ai/keys.db
XFI_AI_KEY_PEPPER=replace_with_long_random_value
