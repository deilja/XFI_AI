# Groq secret. Never expose this value to clients.
GROQ_API_KEY=replace_with_real_groq_key

# Secret used only by the admin page to issue XFI proxy keys.
XFI_AI_ADMIN_KEY=replace_with_long_random_value

# SQLite database for hashed proxy keys.
XFI_AI_DB=/var/lib/xfi-ai/keys.db
XFI_AI_KEY_PEPPER=replace_with_long_random_value
