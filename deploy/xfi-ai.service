[Unit]
Description=XFI AI Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xfi-ai
Group=xfi-ai
WorkingDirectory=/opt/xfi-ai
EnvironmentFile=/etc/xfi-ai/xfi-ai.env
ExecStart=/opt/xfi-ai/venv/bin/uvicorn app.api:app --host 127.0.0.1 --port 8091 --proxy-headers
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/xfi-ai

[Install]
WantedBy=multi-user.target
